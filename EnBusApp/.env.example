# App móvil (Expo). Copia este archivo a .env.local; para los builds de EAS, configúralas
# en el proyecto de EAS (eas env) o en eas.json. Las EXPO_PUBLIC_* quedan dentro de la
# app instalada: aquí nunca va una clave secreta (service role).

EXPO_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# Clave pública (anon / publishable), protegida por RLS.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# WhatsApp de soporte en formato local o internacional: 04121234567 o 584121234567.
EXPO_PUBLIC_SOPORTE_WHATSAPP=
# Landing (términos, privacidad, eliminar cuenta), sin "/" final.
EXPO_PUBLIC_SITIO_URL=https://enbus-hazel.vercel.app
