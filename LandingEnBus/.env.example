# Landing (Next.js). Copia este archivo a .env.local y rellena los valores.
# En Vercel, configúralas en Settings → Environment Variables. Nunca subas .env.local al repo.
# Sin las variables de Supabase la landing funciona igual, pero oculta rutas, cifras,
# calculadora y rastreo.

# ─── Supabase (solo servidor) ────────────────────────────────────────────────
# URL del proyecto (también vale SUPABASE_URL).
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# Clave secreta (service role). SOLO servidor: nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─── URLs públicas (sin "/" final) ───────────────────────────────────────────
# Landing: metadataBase, canonical, imagen OG, robots.txt y sitemap.xml.
NEXT_PUBLIC_SITIO_URL=https://enbus-hazel.vercel.app
# Panel de cooperativas: botón de registro, inicio de sesión y enlaces de invitación.
NEXT_PUBLIC_COOPERATIVAS_URL=https://<dominio-del-panel>

# ─── Soporte (opcionales) ────────────────────────────────────────────────────
# WhatsApp en formato local o internacional: 04121234567 o 584121234567.
NEXT_PUBLIC_SOPORTE_WHATSAPP=
NEXT_PUBLIC_SOPORTE_CORREO=

# ─── Correo (reenvío de invitaciones) ────────────────────────────────────────
RESEND_API_KEY=
# Remitente con un dominio verificado en Resend. Sin él se usa onboarding@resend.dev,
# que solo entrega al correo del dueño de la cuenta de Resend.
RESEND_FROM="EnBus <no-responder@tu-dominio.com>"
