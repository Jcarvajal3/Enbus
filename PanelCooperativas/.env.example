# Panel de cooperativas y super admin (Next.js). Copia este archivo a .env.local.
# En Vercel, configúralas en Settings → Environment Variables. Nunca subas .env.local al repo.

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# Clave pública (anon / publishable): la usa el navegador, protegida por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta (service role). SOLO servidor: nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─── URLs públicas (sin "/" final) ───────────────────────────────────────────
# El propio panel (enlaces de invitación y redirecciones de Auth).
NEXT_PUBLIC_COOPERATIVAS_URL=https://<dominio-del-panel>
# Sitio público (portada, /terminos, /privacidad, /eliminar-cuenta): vive en este mismo
# proyecto, así que es el mismo dominio del panel. Lo usan el canonical, robots.txt,
# sitemap.xml, la app y el registro de cooperativas.
NEXT_PUBLIC_SITIO_URL=https://enbus-hazel.vercel.app
# Enlaces de la app en las tiendas (https://…). Vacíos, el sitio dice "llega pronto".
NEXT_PUBLIC_APP_ANDROID_URL=
NEXT_PUBLIC_APP_IOS_URL=

# ─── Soporte y correo ────────────────────────────────────────────────────────
# WhatsApp en formato local o internacional: 04121234567 o 584121234567.
NEXT_PUBLIC_SOPORTE_WHATSAPP=
# Correo de soporte que muestran el pie del sitio y las páginas legales.
NEXT_PUBLIC_SOPORTE_CORREO=
RESEND_API_KEY=
# Remitente con un dominio verificado en Resend. Sin él se usa onboarding@resend.dev,
# que SOLO entrega al correo dueño de la cuenta de Resend (los correos no llegan a nadie más).
RESEND_FROM="EnBus <no-responder@tu-dominio>"

# ─── Notificaciones push del panel (Web Push) ────────────────────────────────
# Clave PÚBLICA VAPID (la de `npx web-push generate-vapid-keys`). Es la misma que VAPID_PUBLIC_KEY
# de los secretos de la edge function push-panel; la privada va SOLO allí, nunca aquí.
# Sin ella, "Impresora y lector" muestra las notificaciones como no configuradas.
# Pasos completos: Audits/pendientes_push_panel.md.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─── Opcionales ──────────────────────────────────────────────────────────────
# "true" activa el service worker también fuera de producción.
NEXT_PUBLIC_SW_ENABLED=
